main
  .l-content
    .l-content__wrapper
      +c-breadcrumbs('', true)

      .faq__wrapper
        .faq__title-group
          h2.faq__title.f-inter-B FAQ
          p.faq__text.f-noto-M
            |フィールドラボのリノベーションについて
            br.sp
            |よくある質問形式にまとめてみました。
        .faq__items
          //- - const faqList = [0, 1, 2, 3]
          -for(let i = 0; i < modal.q.length; i++)
            button.faq__item
              .question
                .question__button.btn-open
                  p.question__text.f-inter-B!=modal.q[i]
                  .question__icon
        .faq__return
          a.faq__return-link(href=pagePath('/about-contact/'))
            .icon
            .text.f-inter-B ABOUT & CONTACT
            
    +c-toTop(true)
  +l-modal('faq')

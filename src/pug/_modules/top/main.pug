.topMain#topMain
  .topMain__mv.swiper 
    .swiper-wrapper 
      -for(let i = 0; i < main.slide.length; i++)
        .swiper-slide 
          a.inner(href="#")
            .main_img: +picture2(`${DUMMY_DIR}top/main${i+1}-pc.jpg`, `${DUMMY_DIR}top/main${i+1}-sp.jpg`, '', '')
            .text-wrapper 
              p.title.f-inter-B!=main.slide[i].title
              p.main_summary.f-noto-B!=main.slide[i].summary
    +c-ctrl-btn('topMain__mv')


      